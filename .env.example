# ── PostgreSQL connection (optional: needed for user accounts/progress sync) ──
# Option A: Full connection URI
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Option B: Individual variables (used when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=ignius_db
PGUSER=postgres
PGPASSWORD=your_password

# ── Groq API Key (for Cinder AI Assistant) ───────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-safeguard-20b

# ── Session Secret (for cookie signing) ───────────────────────────────────────
SESSION_SECRET=your_random_32_byte_secret_here
