# ============================================================
# Ignius Environment Configuration Template
# Copy this file to `.env.local` for local development.
# The app runs fully in guest mode without any of these set.
# ============================================================

# Option A · PostgreSQL connection string (Neon / Supabase / Render / AWS):
DATABASE_URL=postgresql://user:password@host/db_users?sslmode=require

# Option B · Individual PostgreSQL parameters (used when DATABASE_URL is not set):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=db_users
# PGUSER=postgres
# PGPASSWORD=your_postgres_password

# Cookie session signing secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your_random_32_byte_hex_secret_here

# Groq API for Cinder physics study assistant (optional)
# Free API keys available at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-safeguard-20b

# Docker & Nginx Deployment Configuration
HOST_PORT=8080
PORT=3000

